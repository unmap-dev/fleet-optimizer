# Your Unmap browser key, from https://unmap.dev/dashboard (free).
# It ships in the browser bundle: restrict it to your origins (e.g. http://localhost:3208 and your
# production domain) in the dashboard.
NEXT_PUBLIC_UNMAP_KEY=

# Optional. Defaults to https://api.unmap.dev.
# NEXT_PUBLIC_UNMAP_GATEWAY=https://api.unmap.dev

# Optional. The path the app is served under, e.g. /fleet. Empty for a site of its own.
# BASE_PATH=

# Optional. Client-side caps on the scenario the app will solve. Unset means no cap. The hosted
# build sets them to 25 and 5.
# NEXT_PUBLIC_MAX_SHIPMENTS=
# NEXT_PUBLIC_MAX_VEHICLES=
